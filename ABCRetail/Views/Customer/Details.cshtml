@model ABCRetail.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<h2>Customer Details</h2>

<div>
    <h4>Customer</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Photo URL</dt>
        <dd class="col-sm-10">
            <img src="@Model.PhotoUrl" alt="@Model.Name" />
        </dd>

        <dt class="col-sm-2">PhoneNumber</dt>
        <dd class="col-sm-10">@Model.Address</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Position</dt>
        <dd class="col-sm-10">@Model.PhoneNumber</dd>  

    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-partitionKey="@Model.PartitionKey" asp-route-rowKey="@Model.RowKey">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
